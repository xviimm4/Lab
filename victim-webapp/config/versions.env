# ─────────────────────────────────────────────────────────────────────────────
# versions.env — NGUỒN CHÂN LÝ cho reproducibility. Mọi script source file này.
# Ghi vào báo cáo: version + CVE ID (ăn điểm realism + reproducibility).
# Đổi version ở đây để nâng/hạ độ khó qua các vòng.
# ─────────────────────────────────────────────────────────────────────────────

# --- WordPress (nền app thật) ---
WP_VERSION="6.4.3"
WP_SHA256=""                 # (tuỳ chọn) điền sha256 của tarball để verify tải về
WP_DOCROOT="/var/www/html/wordpress"
WP_URL_PATH="/wordpress"

# --- Database (local, không expose) ---
DB_NAME="wordpress"
DB_USER="wpuser"
DB_PASS="ChangeMe_InLabOnly_$RANDOM"   # chỉ dùng trong lab cô lập
DB_HOST="localhost"

# --- V1: WP File Manager (unauth arbitrary file upload) ---
# CVE-2020-25213 — version 6.0 (vá ở 6.9). Pin 6.0 để tái lập.
WPFM_VERSION="6.0"
WPFM_CVE="CVE-2020-25213"
WPFM_SLUG="wp-file-manager"

# --- V2/V3: Apache httpd 2.4.49 (path traversal → read / mod_cgi RCE) ---
# CVE-2021-41773 — 2.4.49. (CVE-2021-42013 cho 2.4.50 nếu muốn vòng khó hơn.)
HTTPD_VERSION="2.4.49"
HTTPD_CVE="CVE-2021-41773"
HTTPD_PREFIX="/opt/httpd-2.4.49"
HTTPD_PORT="8081"            # cổng phụ, tách khỏi apache2 chính (mod_php/WordPress)
APR_VERSION="1.7.4"
APR_UTIL_VERSION="1.6.3"

# --- Mạng / cô lập ---
# Để trống = tự dò interface host-only. Hoặc đặt cứng, ví dụ "192.168.56.0/24".
LAB_CIDR=""
BIND_IFACE=""                # ví dụ "enp0s8" (host-only adapter của VirtualBox)

# --- Splunk index (đã cấu hình forwarding sẵn trên máy) ---
WEB_INDEX="lab_web"
